# Application
APP_NAME=ReMatch API
APP_ENV=development
DEBUG=false

# Optional bearer authentication for exposing the API through a development tunnel.
# Leave disabled for local-only development. Generate a random token of >=32 characters.
REQUIRE_API_AUTH=false
# API_BEARER_TOKEN=<set-a-random-secret-of-at-least-32-characters>

# Database — SQLite for local development (default).
# For PostgreSQL, use e.g.:
# DATABASE_URL=postgresql+psycopg://rematch:rematch@localhost:5432/rematch
DATABASE_URL=sqlite:///./rematch.db

# CORS — comma-separated origins. Leave empty to disable CORS middleware.
# Local Vite defaults (5174 is Vite's next port when 5173 is occupied):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Pagination defaults
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=100
