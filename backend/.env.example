# Application
APP_NAME=ReMatch API
APP_ENV=development
DEBUG=false

# Optional bearer authentication for exposing the API through a development tunnel.
# Leave disabled for local-only development. Generate a random token of >=32 characters.
REQUIRE_API_AUTH=false
# API_BEARER_TOKEN=<set-a-random-secret-of-at-least-32-characters>

# Database — SQLite for local development (default).
# For PostgreSQL, use e.g.:
# DATABASE_URL=postgresql+psycopg://rematch:rematch@localhost:5432/rematch
DATABASE_URL=sqlite:///./rematch.db

# CORS — comma-separated origins. Leave empty to disable CORS middleware.
# Local Vite defaults (5174 is Vite's next port when 5173 is occupied):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Pagination defaults
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=100

# Optional server-side LLM enrichment for event intelligence briefings.
# Leave LLM_ENABLED=false for deterministic-only mode (default).
# Never put these values in the frontend or Vite env — keys stay on the API host.
# See docs/llm-provider.md for provider setup and deployment notes.
LLM_ENABLED=false
# LLM_PROVIDER=openai
# LLM_PROVIDER=azure_openai
# LLM_PROVIDER=openai_compatible
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# OpenAI default base is https://api.openai.com/v1 — override only if needed:
# LLM_BASE_URL=
# Azure OpenAI requires endpoint + deployment:
# LLM_BASE_URL=https://YOUR_RESOURCE.openai.azure.com
# LLM_AZURE_DEPLOYMENT=your-chat-deployment
# LLM_AZURE_API_VERSION=2024-10-21
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_TOKENS=1200
# LLM_MAX_RETRIES=2
# LLM_CACHE_MAX_ENTRIES=128
# LLM_CACHE_TTL_SECONDS=3600

# Google Gemini (official google-genai SDK). Use when LLM_PROVIDER=gemini.
# Read the API key ONLY from GEMINI_API_KEY on the backend — never from Vite/frontend.
# Default model is currently supported by the Gemini Developer API; override if needed.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
